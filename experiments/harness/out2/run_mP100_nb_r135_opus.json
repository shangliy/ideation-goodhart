{"h": {"measure": "P", "k": 100}, "sp": "nb", "rep": 135, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the input-to-output residual where none exists yields a much larger gain than swapping an existing conv/pool for skip."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "When edge 0 is none node 1 is dead, so adding a conv revives edges 2 and 4 too, giving a larger gain than replacing an existing op."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "With edge 0 none node 1 carries no signal, so a conv out of node 1 contributes nothing."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "With edge 0 none node 1 is dead, so a conv from node 1 to node 2 adds nothing."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Without the input skip the network relies on conv paths to the output (and may even be disconnected), so adding a conv on edge 4 matters more."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "If edge 4 is already none, removing edge 5 leaves only edge 3 (or nothing) feeding the output, collapsing accuracy."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "With node-1-to-output removed, deleting the input skip further starves or disconnects the output node."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "If edge 1 is none, removing edge 0 makes both intermediate nodes dead, leaving a nearly empty cell."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Filling an empty edge with a conv adds a new path and capacity, a larger gain than replacing skip/pool/1x1."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Adding a conv where the edge was absent deepens the cell more than swapping an existing op for conv3x3."}], "tok": 30778, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["skip_connect", "skip_connect", "skip_connect", "none", "skip_connect", "skip_connect"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "none", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "none", "none", "nor_conv_3x3"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "none", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "skip_connect"], [3, "skip_connect"]], [["none", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "none", "skip_connect", "none", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_3x3", 