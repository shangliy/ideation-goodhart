{"h": {"measure": "A", "k": 20}, "sp": "nb", "rep": 107, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "higher", "why": "The residual skip on 0->3 is hugely beneficial in conv-based cells (exp 3) but harmful in pooling-dominated cells (exp 4)."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing the input-output skip from a deep conv cell cripples trainability (exps 11, 12), whereas pool-heavy cells do not benefit from the skip."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "Without the 0->3 residual, cutting edge 0 removes a major signal path and costs far more (exp 18 vs 17)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "lower", "why": "If node 2 receives little or no input, a conv on 2->3 has almost nothing to transform (exp 1 vs 2)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "With 0->2 removed, node 2 carries less information, so the conv on edge 5 contributes less (exp 1 vs 2)."}, {"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing a parameter-free pool with a conv adds capacity, while replacing a 3x3 conv with a 1x1 is roughly neutral (exp 16 vs 15)."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "When node 1's outgoing edges are sparse, upgrading 0->1 to a conv has less path to the output (exp 5 vs 6)."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "When 0->2 is absent, replacing the only conv into node 2 with a skip removes more capacity (exp 13 vs 14)."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "In sparse cells with few conv paths, adding a conv on 0->3 provides badly needed capacity (exp 20), whereas in dense conv cells it displaces the crucial skip (exp 19)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "In pooling-dominated cells, adding an identity bypass gives a shallow, low-capacity network and hurts accuracy (exp 4), unlike in conv cells (exp 3)."}], "tok": 15105, "bad": 0, "probes": [[["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "none", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["skip_connect", "nor_conv_3x3", "none", "skip_connect", "none", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [4, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "skip_connect", "nor_conv_3x3"], [4, "none"]], [["nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [1, "avg_pool_3x3"]], [["nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [1, "avg_pool_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "avg_pool_3x3", "avg_pool_3x3"], [3, "none"]], [["nor_conv_3x3", "none", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [2, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [2, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [5, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [0, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["none", "none", "none", "skip_connect", "none", "none"], [3, "nor_conv_3x3"]]]}