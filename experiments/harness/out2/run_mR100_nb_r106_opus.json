{"h": {"measure": "R", "k": 100}, "sp": "nb", "rep": 106, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Filling an absent edge into the output node with a conv adds a whole learnable path, giving far larger gains than swapping an existing op."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting the direct input-to-output 3x3 conv removes substantial capacity, unlike deleting a pool or skip there."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "When edge 0 is absent, node 1 is dead, so adding a conv revives edges 2 and 4 and yields large gains."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing the final 3x3 conv on the deepest path with an identity strips key capacity and hurts much more than replacing weaker ops."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Upgrading a parameter-free pooling on the deep middle edge to a conv strongly improves the deep path."}, {"edit_edge": 1, "edit_op": "none", "cond_edge": 1, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv feeding node 2 loses a learnable branch, hurting more than removing a pool or skip."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Pooling on the input-to-output shortcut degrades features, so replacing it with identity gives larger benefits."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a pool for a 3x3 conv on the node1-to-output edge adds learnable capacity, a larger gain than swapping between convs."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Pruning the 3x3 conv on the deepest path removes the most valuable op, hurting far more than pruning a pool."}, {"edit_edge": 1, "edit_op": "nor_conv_1x1", "cond_edge": 1, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing a parameter-free pool into node 2 with a learnable conv yields larger gains than replacing a conv or skip."}], "tok": 17518, "bad": 0, "probes": [[["avg_pool_3x3", "avg_pool_3x3", "skip_connect", "avg_pool_3x3", "nor_conv_3x3", "avg_pool_3x3"], [3, "none"]], [["nor_conv_3x3", "avg_pool_3x3", "nor_conv_1x1", "none", "avg_pool_3x3", "avg_pool_3x3"], [4, "none"]], [["avg_pool_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_3x3", "none"], [3, "nor_conv_3x3"]], [["none", "avg_pool_3x3", "nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3"], [5, "skip_connect"]], [["none", "none", "none", "none", "nor_conv_3x3", "none"], [0, "skip_connect"]], [["none", "none", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3"], [4, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "none", "nor_conv_3x3", "avg_pool_3x3", "skip_connect"], [3, "none"]], [["nor_conv_1x1", "skip_connect", "nor_conv_1x1", "avg_pool_3x3", "skip_connect", "nor_conv_1x1"], [4, "avg_pool_3x3"]], [["skip_connect", "none", "skip_connect", "avg_pool_3x3", "none", "avg_pool_3x3"], [2, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [1, "none"]], [["skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_3x3", "avg_pool_3x3"], [0, "none"]], [["none", "nor_conv_1x1", "skip_connect", "none", "none", "skip_connect"], [4, "avg_pool_3x3"]], [["nor_conv_3x3", "skip_connect", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3", "avg_pool_3x3", "skip_connect"], [4, "skip_connect"]], [["nor_conv_1x1", "avg_pool_3x3", "nor_conv_3x3