{"h": {"measure": "A", "k": 20}, "sp": "nb", "rep": 104, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Replacing 'none' with a conv adds a new input-to-output path, giving a much larger gain than replacing skip_connect or avg_pool (+3.8/+6.5/+17.5 vs +1.0/0/+3.7)."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Skip already supplies a direct path, so upgrading it to conv3x3 yields less gain than filling an empty edge."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a conv3x3 with skip loses capacity and hurts on all datasets, unlike replacing 'none'."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Adding skip to an empty edge costs nothing in capacity, so the effect is near zero versus clearly negative when replacing conv."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "Adding a conv on a previously empty first edge gives a bigger gain on ImageNet16 than upgrading skip_connect (+7.8 vs +6.1)."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "When the direct edge 3 is absent, pooling on edge 4 hurts less (and can help ImageNet16) than when a skip path exists."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 2, "cond_op": "none", "direction": "lower", "why": "With edge 2 removed, edge 4 carries more of the node-1 information, so degrading it to pooling hurts more."}, {"edit_edge": 1, "edit_op": "nor_conv_1x1", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading skip to conv1x1 gives a larger ImageNet16 and CIFAR-100 gain than upgrading 'none' or avg_pool."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "nor_conv_1x1", "direction": "higher", "why": "With edge 1 intact, edge 5 gets richer inputs from node 2, so upgrading it to conv3x3 gains slightly more than when edge 1 is removed."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding conv3x3 on an empty edge 5 restores a path into the output and gives a larger gain than replacing skip."}], "tok": 13082, "bad": 0, "probes": [[["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [3, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [3, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3", "nor_conv_1x1", "nor_conv_1x1"], [3, "nor_conv_3x3"]], [["none", "none", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [3, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "none", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "none"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [2, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "none", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [2, "skip_connect"]], [["nor_conv_1x1", "none", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [2, "skip_connect"]], [["nor_conv_3x3", "skip_connect", "nor_