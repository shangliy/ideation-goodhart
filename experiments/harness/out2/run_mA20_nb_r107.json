{"h": {"measure": "A", "k": 20}, "sp": "nb", "rep": 107, "hyps": [{"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading a skip on edge 0 to a 3x3 conv gained more than upgrading none or avg_pool on all three datasets."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv where the edge was empty helps, while replacing a skip with a conv hurt."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 4, "cond_op": "skip_connect", "direction": "lower", "why": "With edge 4 already a skip, a skip on edge 5 adds little capacity, so the edit did worse than with edge 4 as none or a conv."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 removed, weakening edge 4 hurts more because it is the last path from node 1 into the output."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "With edge 3 absent, removing edge 5 leaves the output with far fewer parametric inputs, so the drop is larger."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling an empty direct input-to-output edge with a conv gives a bigger gain than replacing an existing op."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "Replacing a missing edge with a 3x3 conv adds capacity and connectivity, which gains more than replacing an existing op."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Restoring the last edge into the output with a conv gives a bigger gain than swapping one op for another."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Replacing a removed edge with a conv restores a feature path, which gains more than replacing an existing op."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Replacing a removed intermediate edge with a conv restores a path through node 1 to node 2, which gains more than replacing an existing op."}], "tok": 14793, "bad": 0, "probes": [[["skip_connect", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_3x3", "nor_conv_3x3"], [5, "skip_connect"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1", "none", "none", "nor_conv_3x3"], [5, "skip_connect"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1", "none", "skip_connect", "nor_conv_3x3"], [5, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [2, "nor_conv_1x1"]], [["none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [2, "nor_conv_1x1"]], [["nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [2, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [4, "avg_pool_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [4, "avg_pool_3x3"]], [["nor_conv_3x3", "nor_conv