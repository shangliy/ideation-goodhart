{"h": {"measure": "P", "k": 100}, "sp": "nb", "rep": 134, "hyps": [{"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "If edge 4 is none, node 1 reaches the output only through edge 2, so upgrading edge 0 helps less (and not at all when edge 2 is also none)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Putting a 3x3 conv where there was no edge adds a whole new path to the output, which gains more than swapping out an op that is already there."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the input-to-output residual to a cell that lacks one gives a much larger gain than replacing an existing conv or pool on that edge."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Removing the residual shortcut hurts trainability far more than removing a redundant conv or pool on edge 3."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "If edge 4 is none, removing edge 5 leaves the output with only edge 3, so all learned conv paths are lost."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "If edge 5 is none, edge 4 is the last conv path into the output, so removing it causes a large drop."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "If edge 4 is none, node 1 feeds the output only through edge 2, so removing edge 0 costs less."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "If edge 0 is none, node 1 carries zero features, so putting a conv on edge 4 adds almost nothing."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "If edge 1 is none, edge 2 is node 2's only input, so removing it also cuts off the edge 5 path to the output."}, {"edit_edge": 1, "edit_op": "none", "cond_edge": 2, "cond_op": "none", "direction": "lower", "why": "If edge 2 is none, edge 1 is node 2's only input, so removing it removes node 2's contribution to the output entirely."}], "tok": 31774, "bad": 0, "probes": [[["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "none"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "none", "nor_conv_3x3"], [0, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [0, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [5, "avg_pool_3x3"]], [["nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [5, "avg_pool_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [1, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [1, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [4, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [4, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [2, "skip_connect"]], [["skip_conn