{"h": {"measure": "R", "k": 100}, "sp": "nb", "rep": 115, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv on the missing direct input-output edge restores a strong path, giving large gains (exps 9, 32, 49)."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "Without the direct 0->3 edge, removing edge 0 disconnects much more signal from the output (exp 52)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "If edge 4 is absent, deleting edge 5 strips node 3 of most of its inputs (exp 20)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing a learned conv on the direct path with an identity loses capacity (exps 3, 56 vs 42)."}, {"edit_edge": 3, "edit_op": "avg_pool_3x3", "cond_edge": 3, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Swapping a conv for a parameter-free pool on the direct path hurts (exps 4, 31)."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on the deepest path with identity removes key capacity (exps 100, 93)."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Converting a pool to a conv on the 0->1->3 path adds capacity (exps 89, 97)."}, {"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing a pool feeding the output with a conv improves accuracy (exps 10, 24)."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 removed node 2 cannot reach the output, so a conv on edge 2 is useless."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "directio