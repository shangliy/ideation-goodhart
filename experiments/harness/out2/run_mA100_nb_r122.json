{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 122, "hyps": [{"edit_edge": 1, "edit_op": "nor_conv_1x1", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Replacing a removed edge 1 with a conv reconnects the path (+5 to +20 across datasets), while replacing a conv3x3 or skip on edge 1 gives roughly zero or negative change."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv where the direct input-to-output edge was absent restores connectivity and gives much larger gains (e.g. +78 on a near-disconnected parent) than swapping one op for another."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling a missing edge 3 with a skip adds a path and gains accuracy (+2.7, +1.0, +3.3, +73.6 on C10), whereas replacing an existing conv3x3 with skip is mostly neutral or harmful."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Edge 5 set to none is the one-step reconnection to the output (+77 C10), unlike replacing existing ops, which gives small changes."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "With edge 2 removed, node 1 reaches the output only through edge 4, so upgrading it matters more (+6.5 to +76 on e2=none parents, versus about 0 on others)."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 0, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a parameter-free skip on edge 0 is harmless or even helpful (+41.9 on the all-skip parent), while removing a conv on edge 0 hurts (-1 to -77)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 5, "cond_op": "skip_connect", "direction": "higher", "why": "Dropping a weak skip on edge 5 costs little or even helps (+42.5 on the all-skip parent), while dropping a conv on edge 5 consistently hurts."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip on edge 2 is about neutral, and positive on weak parents (+28.6), while removing a conv3x3 on edge 2 is negative."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Upgrading a conv1x1 on edge 0 to conv3x3 yields only small changes (-0.8 to +3.3 on C10), while replacing a skip or avg_pool on edge 0 yields up to +43."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a conv3x3 on edge 2 with skip loses capacity (-0.4 to -1.7), unlike filling an empty edge 2 where skip adds a useful path."}], "tok": 30316, "bad": 1, "probes": [[["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [5, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "none", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "none", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none", "avg_pool_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "none", "none", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "none", "none", "none", "none"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "skip_connect", "none", "nor_conv_3x3", "none", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [0, "nor_co