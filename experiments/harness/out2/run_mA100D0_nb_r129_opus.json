{"h": {"measure": "A", "k": 100, "control": "D0"}, "sp": "nb", "rep": 129, "hyps": [{"edit_edge": 3, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 absent, the input->output skip carries much of the signal, so removing it hurts more."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Replacing 'none' restores the node2->output path rather than merely swapping an existing op."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "When edge 0 is none node 1 is zero, so edges 2 and 4 are dead; adding a conv revives them."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Without an input->output skip, adding a skip into the output provides needed residual-like gradient flow."}, {"edit_edge": 2, "edit_op": "avg_pool_3x3", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a learnable 3x3 conv with parameter-free pooling loses capacity."}, {"edit_edge": 1, "edit_op": "skip_connect", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Adding a missing input->node2 path helps more than replacing an existing conv with a skip."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "If edge 4 is already none, removing edge 5 leaves only edge 3 feeding the output, collapsing the cell."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling an empty edge adds a path, whereas replacing a skip with a 1x1 conv removes the residual connection."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "When edge 0 is none node 1 is zero, so a conv on edge 2 has no useful input and no effect."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Swapping a strong 3x3 conv for avg pooling on edge 4 removes learnable capacity."}], "tok": 14791, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "none"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [3, "none"]], [["none", "nor_conv_3x3", "none", "skip_connect", "none", "nor_conv_3x3"], [3, "none"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [3, "none"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [3, "none"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "avg_pool_3x3", "avg_pool_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_connect", "skip_connect", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none",