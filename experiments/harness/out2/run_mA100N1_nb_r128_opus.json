{"h": {"measure": "A", "k": 100, "noise": "N1"}, "sp": "nb", "rep": 128, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv where the input-output edge was absent gives large gains (exps 1-3, 8-11, 100), unlike replacing skip/avg_pool (exps 4-7)."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing the residual skip on edge 3 with a conv was negative on all datasets (exps 4-5)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a residual shortcut where none existed gives the largest gain (exp 26 vs 25, 27, 28)."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a conv on the direct input-output edge hurts (exp 74), while removing a skip in skip-heavy cells helps (exp 79)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "Without edge 3, edge 5 is a critical path to the output, so removing it is far more damaging (exps 14, 18)."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "Cutting edge 0 when edge 3 is absent can disconnect the output and collapse accuracy (exps 23-24)."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 gone, the output relies on node 1 via edge 4, so removing edge 0 is much more harmful (exp 24)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 5, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip on edge 5 helps skip-heavy cells (exp 81), whereas removing a conv on edge 5 always hurts (exps 13-18)."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Parents already rich in 3x3 convs gain little from another conv (exps 1-7) compared with conv-poor parents (exps 8-12, 57, 63)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Diminishing returns: adding a conv to edge 5 helps much less when edge 4 already has a conv (exp 91 vs 53, 59)."}], "tok": 18220, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "none"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "none"], [3, "nor_conv_3x3"]], [["nor_conv_1x1", "skip_connect", "nor_conv_1x1", "none", "skip_connect", "nor_conv_1x1"], [3, "nor_conv_3x3"]], [["nor_conv_1x1", "skip_connect", "nor_conv_1x1", "none", "skip_connect", "none"], [3, "nor_conv_3x3"]], [["none", "none", "none", "none", "none", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "none", "none", "none", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [5, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [5, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [5, "none"]], [[