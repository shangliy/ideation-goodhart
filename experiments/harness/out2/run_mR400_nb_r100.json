{"h": {"measure": "R", "k": 400}, "sp": "nb", "rep": 100, "hyps": [{"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "Replacing a missing input edge with a 3x3 conv gives large gains (e.g. experiments 152, 166, 219, 262, 337, 392), more than replacing an existing conv."}, {"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Swapping a 3x3 conv for a 1x1 conv gives roughly zero or negative change (experiments 110, 92), while upgrading from pool, skip or none gives gains."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Going from 1x1 to 3x3 on edge 3 changes little or hurts (experiments 27, 124, 218, 395), while replacing none, skip or pool gives large gains."}, {"edit_edge": 3, "edit_op": "avg_pool_3x3", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 3 with pooling causes big drops (experiments 202, 238, 321, 387)."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Converting a pooling edge 1 to a 3x3 conv gives consistent gains (experiments 101, 115, 265, 329), larger than when edge 1 is already skip or conv."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 0, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip edge 0 is near-neutral or positive (experiments 81, 299, 383), while removing a conv edge 0 is strongly harmful."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 4, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing a 1x1 conv on edge 4 with skip tends to hurt (experiments 40, 51, 70, 264), while replacing pool or none is neutral or positive."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "skip_connect", "direction": "lower", "why": "Removing a skip connection on edge 2 causes large drops (experiments 240, 261, 288), while removing a conv on edge 2 is about neutral."}, {"edit_edge": 0, "edit_op": "nor_conv_1x1", "cond_edge": 0, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading a skip edge 0 to a 1x1 conv gives solid gains (experiments 60, 97, 121), more than other starting ops."}, {"edit_edge": 0, "edit_op": "avg_pool_3x3", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 0 with pooling is severely harmful (experiments 12, 308, 353, 370), unlike replacing other ops."}], "tok": 52345, "bad": 0, "probes": [[["nor_conv_3x3", "skip_connect", "none", "avg_pool_3x3", "skip_connect", "skip_connect"], [2, "nor_conv_1x1"]], [["none", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "none", "skip_connect", "skip_connect", "none", "avg_pool_3x3"], [4, "skip_connect"]], [["nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3", "none", "none"], [2, "nor_conv_1x1"]], [["none", "skip_connect", "none", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3"], [0, "nor_conv_1x1"]], [["skip_connect", "skip_connect", "nor_conv_3x3", "nor_conv_3x3", "none", "avg_pool_3x3"], [5, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "none"], [0, "nor_conv_1x1"]], [["nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3", "none", "none", "nor_conv_1x1"], [0, "skip_connect"]], [["avg_pool_3x3", "none", "nor_conv_1x1", "skip_connect", "avg_pool_3x3", "skip_connect"], [2, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_1x1", "avg_pool_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [4, "nor_conv_1x1"]], [["avg_pool_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "skip_connect", "avg_pool_3x3"], [4, "avg_pool_3x3"]], [["nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none", "nor_conv_3x3", "none"], [0, "avg_pool_3x3"]], [["nor_conv_3x3", "avg_pool_3x3", "nor_conv_1x1", "none", "skip_c