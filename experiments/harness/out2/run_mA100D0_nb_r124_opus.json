{"h": {"measure": "A", "k": 100, "control": "D0"}, "sp": "nb", "rep": 124, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Filling a missing node2->output edge with a conv adds a whole new learned path to the output, a bigger gain than swapping out an existing op."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing the input-to-output skip removes the residual path that NB201 cells rely on, so the conv's benefit is offset."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv where no direct input-to-output connection existed adds capacity without removing anything useful."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting edge 0 hurts most when it carried the strongest op, since node 1 then loses its learned features."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "With edge 1 also absent, removing edge 0 cuts off nodes 1 and 2 entirely and collapses the cell to edge 3 alone."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "If node 1 receives nothing, a skip from node 1 to node 2 just passes zeros and cannot help."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "Adding a conv on a missing node1->output edge creates a new deep path to the output, beyond what swapping an existing op gives."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Filling the empty input->node2 edge with a conv adds a new feature path instead of replacing an existing one."}, {"edit_edge": 5, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Swapping a conv for parameter-free pooling on the final edge loses the most capacity when that conv was 3x3."}, {"edit_edge": 0, "edit_op": "nor_conv_1x1", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "Adding a conv where node 1 had no input reactivates every path downstream of node 1, giving a large gain."}], "tok": 14346, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "none", "nor_conv_1x1", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "none", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "skip_connect", "none", "nor_conv_1x1", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "skip_connect", "skip_connect", "nor_conv_1x1", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_1x1", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "skip_connect", "skip_connect", "nor_conv_1x1", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_3x3"], [3, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "skip_connect", "avg_pool_3x3", "nor_conv_1x1", "nor_conv_3x3"], [3, "nor_conv_3