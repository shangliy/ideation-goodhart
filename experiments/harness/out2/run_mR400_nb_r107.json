{"h": {"measure": "R", "k": 400}, "sp": "nb", "rep": 107, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing a skip with a conv on edge 5 gave +4.5 to +9 points in runs 22 and 25, while replacing a 3x3 conv with a 1x1 conv gave about zero or negative."}, {"edit_edge": 2, "edit_op": "nor_conv_1x1", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading a skip on edge 2 to a conv gave large gains in runs 73, 367 and 375, while the other replaced ops gave small or mixed changes."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a pooling edge 3 for a skip gave +4 to +12 points in runs 59, 88, 165 and 309, whereas replacing a conv with a skip was neutral or harmful."}, {"edit_edge": 4, "edit_op": "nor_conv_1x1", "cond_edge": 4, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing pooling on edge 4 with a 1x1 conv gave large gains in runs 26 and 299, while other replaced ops gave about zero."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 4 with pooling gave sharply negative changes in runs 231 and 342, worse than replacing a skip."}, {"edit_edge": 1, "edit_op": "avg_pool_3x3", "cond_edge": 1, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing a 1x1 conv on edge 1 with pooling lost about 10 to 11 points on CIFAR-100 in runs 108 and 157, more than the small losses from replacing a skip."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "With edge 1 already absent, removing edge 0 cuts the main feature path, as in runs 114, 144 and 75."}, {"edit_edge": 5, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing a 1x1 conv on edge 5 with pooling consistently hurt in runs 197, 216, 229 and 232."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Adding a 3x3 conv where edge 2 was absent gave gains in runs 23, 47 and 106, larger than the near-zero changes when swapping existing ops."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a conv where edge 5 was absent gave large gains in runs 58, 91 and 241, larger than changes when replacing an existing op."}], "tok": 52844, "bad": 0, "probes": [[["nor_conv_3x3", "skip_connect", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_1x1", "none"], [3, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "skip_connect", "nor_conv_1x1"], [4, "nor_conv_1x1"]], [["nor_conv_1x1", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [0, "none"]], [["skip_connect", "avg_pool_3x3", "nor_conv_3x3", "avg_pool_3x3", "none", "none"], [2, "nor_conv_1x1"]], [["none", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "avg_pool_3x3"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "skip_connect", "skip_connect", "none", "nor_conv_1x1"], [1, "nor_conv_3x3"]], [["nor_conv_1x1", "avg_pool_3x3", "nor_conv_1x1", "avg_pool_3x3", "none", "none"], [0, "none"]], [["none", "none", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "avg_pool_3x3"], [3, "none"]], [["none", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1"], [1, "skip_connect"]], [["none", "skip_connect", "none", "skip_connect", "skip_connect", "none"], [2, "nor_conv_3x3"]], [["none", "skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3"], [0, "nor_conv_1x1"]], [["none", "avg_pool_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [5, "avg_pool_3x3"]], [["none", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "none", "skip_connect"], [3, "skip_connect"]], [["avg_pool_3x3