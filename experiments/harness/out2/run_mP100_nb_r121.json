{"h": {"measure": "P", "k": 100}, "sp": "nb", "rep": 121, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Replacing none with a skip adds a direct input-output path, whereas replacing a conv with skip loses capacity."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "Restoring a removed first edge with a conv gains far more than upgrading an existing skip, pool or 1x1 op."}, {"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a conv on a missing edge into the output helps more than replacing an existing 3x3 conv with a 1x1."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a skip to a missing output edge restores connectivity, whereas replacing a conv with skip hurts."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv costs more accuracy than removing a skip or pool edge."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting the first-layer conv edge hurts much more than deleting a skip or pool edge there."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Adding a skip on an absent edge 1->2 improves connectivity, whereas replacing a conv loses capacity."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Adding a 3x3 conv on an absent edge gains more than upgrading an existing skip, pool or 1x1 edge."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "Adding a 3x3 conv on a removed edge 1->3 gains more than upgrading an already present op."}, {"edit_edge": 1, "edit_op": "avg_