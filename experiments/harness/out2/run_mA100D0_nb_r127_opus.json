{"h": {"measure": "A", "k": 100, "control": "D0"}, "sp": "nb", "rep": 127, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Replacing 'none' reconnects node 2 to the output and adds a conv path, a larger gain than swapping out an existing skip or pool."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the input-to-output residual where none existed helps much more than replacing an existing conv or pool on edge 3."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "With edge 5 absent there are fewer paths to the output, so the direct skip contributes more and can even rescue a disconnected cell."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "When edge 0 is none, node 1 gets no input and edges 2 and 4 are dead, so adding a conv activates them for a large gain."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv loses more capacity than removing a skip, pool or 1x1 conv on the same edge."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 absent, edge 4 is a main route to the output, so deleting it is much more damaging."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Removing the residual skip hurts optimization more than removing a conv or pool on edge 3."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "In deep conv-heavy cells the edge-3 skip is the key residual path, so removing it hurts more than in skip- or pool-dominated cells."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Swapping a 3x3 conv for a skip on edge 5 loses capacity, whereas swapping out none or a pool tends to help."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "If edge 1 is also none, removing edge 0 cuts off both intermediate nodes and leaves only edge 3, a severe drop."}], "tok": 14120, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "none", "none", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "none", "none"], [5, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["skip_connect", "skip_connect", "skip_connect", "none", "skip_connect", "skip_connect"],