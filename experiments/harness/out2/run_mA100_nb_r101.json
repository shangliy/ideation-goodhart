{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 101, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on the direct 0->3 edge with skip lost accuracy in runs 33, 39 and 40, whereas replacing other ops was neutral or positive."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling an empty direct 0->3 edge with skip gave large gains (runs 35, 36, 38), while replacing a conv op with skip was neutral or harmful."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv to a missing direct edge gives gains (runs 65, 68), whereas replacing existing ops with it is often neutral or negative (runs 61, 66, 67)."}, {"edit_edge": 0, "edit_op": "avg_pool_3x3", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on the input edge with pooling hurt in runs 91, 94, 96 and 100, with a typically larger drop on ImageNet16."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv on edge 2 was negative or zero in runs 81, 85, 88 and 89, while removing weaker ops sometimes helped."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip on edge 2 was positive in runs 83 and 87, while removing conv ops was mostly negative."}, {"edit_edge": 4, "edit_op": "nor_conv_1x1", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Downgrading a 3x3 conv to 1x1 on edge 4 was negative on all datasets in runs 41 and 47."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a 3x3 conv to a missing final edge gave solid gains in runs 51 and 59, larger than replacing existing ops (runs 56 to 58, 60)."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading a skip on edge 2 to a 3x3 conv improved accuracy on all datasets in runs 21, 23 and 28, mostly more than other replacements."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a skip to an empty final edge gave a gain in run 79, while replacing real ops with skip mostly hurt (runs 71, 76, 78, 80)."}], "tok": 32980, "bad": 0, "probes": [[["avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["none", "none", "none", "none", "none", "none"], [0, "nor_conv_3x3"]], [["skip_connect", "none", "nor_conv_1x1", "skip_connect", "avg_pool_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "none", "nor_conv_1x1", "nor_conv_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "avg_pool_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "none"], [0, "nor_conv_3x3"]], [["none", "skip_connect", "avg_pool_3x3", "nor_conv_3x3", "none", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [1, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [1, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [1, "nor_conv_3x3"]],