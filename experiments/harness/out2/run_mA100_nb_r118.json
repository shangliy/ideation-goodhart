{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 118, "hyps": [{"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing a parameter-free skip with a 3x3 conv gives a much larger gain than replacing other ops, as in the all-skip parent (+43)."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "Upgrading a skip edge to a conv gives large gains (+34 to +37 in the weak parents) versus near zero when the edge already holds a conv."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Skip-to-3x3 on edge 2 yields +35 in the all-skip parent but only small gains elsewhere."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing the direct input-output skip with a conv helps most when the network has no other conv capacity (+36 in the all-skip parent)."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "skip_connect", "direction": "higher", "why": "Skip-to-3x3 on edge 4 gives large gains in the all-skip parent (+35) and moderate gains in the other skip cases."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "skip_connect", "direction": "higher", "why": "Edge 5 feeds the output, so replacing its skip with a conv gives a very large gain in the all-skip parent (+45)."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 2 with a skip consistently reduces accuracy (-0.5 to -6), while replacing other ops changes it little."}, {"edit_edge": 5, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing the output edge's 3x3 conv with pooling costs accuracy on all three datasets (rows 95 and 100)."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv edge hurts (-0.5 to -15), whereas removing a weak skip or pool edge can help."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip on edge 4 helped greatly in the all-skip parent (+27 on CIFAR-10), unlike removing a conv edge."}], "tok": 31985, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [0, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "none", "skip_connect", "nor_conv_1x1", "avg_pool_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "skip_connect", "none", "nor_conv_3x3", "skip_connect", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_3x3", "none", "nor_conv_1x1", "skip_connect"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "none", "skip_connect", "nor_conv_3x3", "none"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "none", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [1, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [1, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [1, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_