{"h": {"measure": "A", "k": 100, "noise": "L"}, "sp": "nb", "rep": 129, "hyps": [{"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Removing the input-to-output skip residual hurts far more than removing a conv or pool on that edge (exp 1 vs 2, 3)."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling an empty input-to-output edge restores a direct path and gives large gains (exp 71, 75-79)."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing the residual skip on edge 3 with a 1x1 conv loses the identity shortcut (exp 72)."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "With edge 4 absent, removing edge 3 leaves only one path to the output, which is much more damaging (exp 4, 6)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "Removing edge 5 when edge 4 is already gone strips most of the computation reaching the output (exp 63, 64)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a skip into the output helps most when the main input-to-output residual is missing (exp 34)."}, {"edit_edge": 1, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "A skip on edge 1 supplies an identity path that substitutes for a missing edge-3 residual (exp 57, 58)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "skip_connect", "direction": "lower", "why": "Skips on both edge 0 and edge 4 create a redundant identity path parallel to edge 3 and remove conv depth (exp 37)."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "lower", "why": "When edge 2 is none, node 1 feeds the output only via edge 4, so a conv on edge 0 adds less (exp 25, 27)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "In skip-heavy cells with little conv capacity, adding a 3x3 conv on the final edge gives large gains (exp 16, 19)."}], "tok": 18014, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "none"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "none", "nor_conv_3x3"], [3, "none"]], [["none", "nor_conv_3x3", "none", "skip_connect", "none", "nor_conv_3x3"], [3, "none"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [3, "none"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [3, "none"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "avg_pool_3x3", "avg_pool_3x3"], [3, "none"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_