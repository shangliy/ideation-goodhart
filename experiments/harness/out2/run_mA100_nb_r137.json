{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 137, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Replacing a missing direct input-to-output edge with a 3x3 conv restores connectivity and gives large gains, whereas replacing an existing skip_connect loses accuracy."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Filling a none edge 3 with a skip adds an input-to-output path, which helps far more than replacing an existing conv or pool op with a skip."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "With edge 3 absent, removing edge 4 can cut the remaining routes to the output, causing a catastrophic drop."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "When edge 5 is none, edge 4 is a main path to the output, so removing it is much more harmful."}, {"edit_edge": 0, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "Replacing a none edge 0 with a skip adds parameter-free paths where a conv or pool was missing, and this is consistently negative on all three datasets."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing a skip on edge 3 with a 3x3 conv is negative (row 75), unlike the strong gains when edge 3 was none or a weak op."}, {"edit_edge": 2, "edit_op": "avg_pool_3x3", "cond_edge": 2, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing a skip with pooling on the inner edge tends to hurt, as in rows 46 and 48."}, {"edit_edge": 1, "edit_op": "nor_conv_1x1", "cond_edge": 1, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a parameter-free pool for a conv on edge 1 gives big gains in weak pooling-only cells (row 33)."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing a skip on edge 2 with a 3x3 conv gives a large gain in skip-only parents and a small gain otherwise."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing a parameter-free pool on edge 0 with a 3x3 conv adds learnable capacity, giving large gains in pooling-heavy parents."}], "tok": 29724, "bad": 0, "probes": [[["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["none", "nor_conv_3x3", "nor_conv_1x1", "skip_connect", "avg_pool_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "none", "nor_conv_3x3", "none", "nor_conv_3x3"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_1x1", "skip_connect", "none", "nor_conv_3x3", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "none", "none", "skip_connect", "none", "skip_connect"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3", "none", "none", "none"], [0, "nor_conv_3x3"]], [["none", "skip_connect", "avg_pool_3x3", "nor_conv_1x1", "nor_conv_3x3", "skip_connect"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [5, "nor_conv_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "n