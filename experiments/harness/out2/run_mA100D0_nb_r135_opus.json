{"h": {"measure": "A", "k": 100, "control": "D0"}, "sp": "nb", "rep": 135, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Adding a conv where edge 5 was empty opens a new path from node 2 to the output, which gains more than replacing an existing skip or pool op."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the input-to-output residual where none existed gives a large gain, whereas replacing a conv or pool on edge 3 changes accuracy only modestly."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "Removing the skip edge hurts more when edge 5 is also empty, because the cell is left with fewer paths to the output and becomes harder to optimize."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "When edge 1 is already none, cutting edge 0 disconnects nodes 1 and 2 entirely, leaving only edge 3 and causing a collapse."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "With edge 2 empty, node 2 receives no input unless edge 1 is active, so adding a conv there reactivates the edge 5 path."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "If edge 5 is none, a conv on edge 4 becomes the only learned route into the output, so its marginal value is larger."}, {"edit_edge": 2, "edit_op": "avg_pool_3x3", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Putting a pool on an empty edge 2 adds connectivity, while replacing a 3x3 conv with a parameter-free pool removes capacity."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "A skip on an empty edge 5 adds a path from node 2, whereas replacing a 3x3 conv with skip loses depth and capacity."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "A pool added to an empty edge 4 is neutral to positive, while a pool replacing a 3x3 conv on edge 4 usually lowers accuracy."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "A 1x1 conv on an empty edge 3 adds a direct input-to-output path, while replacing a skip or 3x3 conv on that edge gives little or a negative change."}], "tok": 14457, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "none", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "none", "none", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3,