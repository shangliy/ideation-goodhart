{"h": {"measure": "A", "k": 100, "control": "D0"}, "sp": "nb", "rep": 122, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a residual input-to-output path where none exists gives a much larger gain than swapping a conv or pool on edge 3 for a skip."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "Without edge 4, removing the direct skip leaves only the deep path through node 2, which loses both the residual and path diversity and hurts more."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "If edge 1 is none, cutting edge 0 also disconnects node 2, collapsing the whole cell to its direct edge 3."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "With edge 1 removed, node 2 has weaker or no input, so a conv on edge 5 adds little capacity."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "When edge 0 is none, node 1 is zero, so a conv on edge 4 operates on nothing."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "When edge 0 is none, node 1 carries no signal, so a conv from node 1 to node 2 is useless."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "If edge 1 is none, activating node 1 also restores input to node 2, so a conv on edge 0 unlocks more of the cell."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 absent, removing edge 4 leaves the output fed only by edge 3, eliminating all learned depth."}, {"edit_edge": 0, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "A skip on edge 0 reconnects node 1 when replacing none, but loses learned capacity when replacing a conv."}, {"edit_edge": 1, "edit_op": "none", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "When edge 0 is none, edge 1 is the only route into node 2, so removing it cuts off the deep paths."}], "tok": 14788, "bad": 0, "probes": [[["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_connect", "skip_connect", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "none", "nor_conv_3x3", "none"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "none", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["skip_connect", "skip_connect", "skip_connect", "none", "skip_connect", "skip_connect"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["