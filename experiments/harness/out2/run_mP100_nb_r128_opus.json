{"h": {"measure": "P", "k": 100}, "sp": "nb", "rep": 128, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the 0->3 residual where no edge existed gives a larger gain than replacing an existing conv or pool on that edge."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 2, "cond_op": "none", "direction": "lower", "why": "With edge 2 empty, node 2 receives little or no signal, so a conv on edge 2->3 adds little."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing edge 0 cuts off the strong conv path 0->1->3 when edge 4 is a 3x3 conv, but costs little when node 1 is a dead end."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "skip_connect", "direction": "higher", "why": "A skip on edge 1->3 partly takes over the identity-like path, so losing the 0->3 skip hurts less."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing an already useful skip gains less than replacing none or avg_pool with a 3x3 conv."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Upgrading a 1x1 conv to 3x3 is a smaller gain than adding a conv where there was none, a skip, or a pool."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 2, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a weak avg_pool for a skip helps, while swapping a 3x3 conv for a skip loses capacity."}, {"edit_edge": 5, "edit_op": "nor_conv_1x1", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "With no edge from node 1 to the output, edge 5 carries the main conv path, so downgrading it to 1x1 hurts more."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing the beneficial 0->3 residual with a conv is worse than filling an empty edge 3 with a conv."}, {"edit_edge": 3, "edit_op": "avg_pool_3x3", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "Putting avg_pool in place of the residual skip loses identity information, while adding it to an empty edge is roughly neutral."}], "tok": 30394, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "none"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_3x3", "nor_conv_1x1", "none", "none", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_3x3", "nor_conv_1x1", "none", "none", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "avg_pool_3x3", "skip_connect", "none", "nor_conv_1x1", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "avg_pool_3x3", "skip_connect", "none", "nor_conv_1x1", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none"], [3, "skip_connect"]], [["skip_connect", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["skip_connect", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "none", "skip_connect", "nor_conv_1x1", "avg_pool_3x3"], [5, "nor_conv_3x3"]]