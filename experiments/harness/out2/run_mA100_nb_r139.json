{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 139, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Turning a missing direct edge 0->3 into a 3x3 conv gains far more (+3.8/+6.5/+17.5) than replacing any existing op."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a skip where edge 3 was absent gives large gains (+2.9/+6.5/+13.8), whereas replacing a conv with skip gives small or negative change."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting a 3x3 conv on the direct edge costs much more than deleting a 1x1 conv."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "When edge 3 already has a 3x3 conv, adding another on edge 0 yields diminishing returns (+0.5/+0.6/+1.7 vs ~+3/+5/+8)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Capacity is already saturated by the 3x3 on edge 3, so upgrading edge 5 gives much smaller gains."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "Replacing avg_pool with a 3x3 conv gains less than replacing none, skip or 1x1 on edge 5."}, {"edit_edge": 5, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Downgrading a 3x3 conv to avg_pool hurts on all datasets, while from a 1x1 conv it is neutral or positive."}, {"edit_edge": 4, "edit_op": "avg_pool_3x3", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 4 with avg_pool loses accuracy (-2/-3.6/-6.3) versus small gains from none, skip or 1x1."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "Upgrading from avg_pool gives a smaller gain (+1.5/+3.0/+3.5) than upgrading from none, skip or 1x1 (+2.3-3.0/+4.4-5.6/+7.9-9.5)."}, {"edit_edge": 2, "edit_op": "nor_conv_1x1", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Downgrading a 3x3 conv to 1x1 on edge 2 costs accuracy on all datasets, unlike replacing none or skip."}], "tok": 32917, "bad": 0, "probes": [[["none", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "skip_connect", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "none", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "none", "nor_conv_1x1", "none", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "avg_poo