{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 115, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding the input-output residual where none existed gives large gains (rows 1-4), while replacing an existing conv/pool on edge 3 gives small gains (rows 6-8)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "With edge 4 missing, the edge-3 skip becomes one of very few routes to the output, so adding it brings huge gains (row 3 vs rows 1-2)."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "When edge 5 is absent, edge 4 is the only conv path into the output node, so adding it helps far more (rows 29-30 vs 21-27)."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "With edge 1 absent, edge 0 is the only way to feed nodes 1 and 2, so adding it reconnects the cell (rows 39-40 vs 31-38)."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Without the edge-3 skip, an extra input path to node 2 matters much more (rows 47-48 vs 41-43)."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "Removing edge 5 when edge 4 is already gone leaves the output almost disconnected and accuracy collapses (row 73 vs 71-72)."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "Removing the edge-3 skip when edge 4 is missing leaves too few input-output routes, giving catastrophic drops (row 70 vs 68-69)."}, {"edit_edge": 2, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "lower", "why": "Swapping the edge-2 conv for a skip removes capacity, which hurts more when there is no edge-3 residual to compensate (row 59 vs 58)."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "Deleting edge 0 when edge 1 is absent cuts every path through nodes 1 and 2, leaving only the skip (row 75 vs 74)."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "Deleting edge 4 when edge 5 is absent removes the last conv input to the output node (row 77 vs 76)."}], "tok": 33254, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "none", "none"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "none", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["skip_connect", "skip_connect", "skip_connect", "none", "skip_connect", "skip_connect"], [3, "skip_connect"]], [["none", "nor_conv_3x3", "none", "none", "none", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "no