{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 104, "hyps": [{"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "A skip-dominated parent gains about +43 points on C10 and C100 and +17 on IN16 from the first conv edge, far more than conv or mixed parents."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "Adding a 3x3 conv to a skip-dominated cell gives about +45 on C10 and C100, versus a few points elsewhere."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "A cell with no learnable convs benefits most from its first 3x3 conv."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "The conv edit gives a +33 to +35 jump on C10 and C100 in a skip-heavy parent, versus about 0 to 3 in mixed parents."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "The edit gives +33 on C10 in a parent with no convs, but under 1 point in mixed parents that already have convs."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 5, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing a skip edge with none helps (+42 in the all-skip parent, small positives in the mixed one), whereas removing conv edges hurts."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "skip_connect", "direction": "higher", "why": "Removing a skip edge improves accuracy (+28 in the all-skip parent, +1.5 to +3.5 in the mixed one), while removing a conv edge hurts."}, {"edit_edge": 1, "edit_op": "none", "cond_edge": 1, "cond_op": "skip_connect", "direction": "higher", "why": "Replacing a skip edge with none is positive or neutral (+27.8 in the all-skip parent), unlike removing a conv edge, which loses accuracy."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "skip_connect", "direction": "higher", "why": "Dropping a skip edge helps the skip-dominated parent (+27 on C10), unlike dropping other ops."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Replacing a pooling edge with a conv gives about +35 on C10 in the all-pool parent, versus near zero when the edge already holds a conv."}], "tok": 31180, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "nor_conv_1x1"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [3, "nor_conv_1x1"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3"], [3, "nor_conv_1x1"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_1x1", "avg_pool_3x3"], [3, "nor_conv_1x1"]], [["nor_conv_1x1", "skip_connect", "none", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3"], [3, "nor_conv_1x1"]], [["skip_connect", "nor_conv_3x3", "avg_pool_3x3", "none", "nor_conv_3x3", "nor_conv_1x1"], [3, "nor_conv_1x1"]], [["avg_pool_3x3", "nor_conv_1x1", "skip_connect", "nor_conv_3x3", "none", "skip_connect"], [3, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_1x1", "none", "skip_connect", "skip_connect", "nor_conv_3x3"], [3, "nor_conv_1x1"]], [["none", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "skip_connect", "none"], [3, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [0, "avg_pool_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [0, "nor_conv_3x3"]], [["avg_pool_3x