{"h": {"measure": "A", "k": 100}, "sp": "nb", "rep": 136, "hyps": [{"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Replacing a missing edge 3 with a conv gave large gains (up to +14 to +24 on ImageNet16-120), while replacing an existing op gave about 0."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "With edge 3 removed, adding a skip on edge 4 gave +17 on ImageNet16-120, whereas other edge-3 ops gave about 0."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing a 3x3 conv on edge 2 hurt on all datasets, whereas removing a skip or pool was near neutral."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "Upgrading an avg_pool edge 0 to 3x3 gained less than upgrading skip, none or 1x1 (+3.7 vs about +8.5 to +10 on ImageNet16-120)."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "Filling an empty edge 5 gained far less than replacing a skip or pool on edge 5, which gained +45 to +51 on CIFAR-10."}, {"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "With the direct edge 3 removed, a 3x3 conv on edge 5 gave +20 to +27 versus +6 to +18 for other edge-3 ops."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 0, "cond_op": "none", "direction": "lower", "why": "With edge 0 removed, upgrading edge 2 gained only about +0.1 to +0.8, versus +2 to +8 otherwise."}, {"edit_edge": 2, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "lower", "why": "With edge 5 removed, upgrading edge 2 gained almost nothing (+0.06, +1.28, -2.07), below the other parents."}, {"edit_edge": 3, "edit_op": "nor_conv_1x1", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "With edge 0 removed, filling edge 3 gave about +22 on all datasets versus roughly +1 to +3 on CIFAR otherwise."}, {"edit_edge": 4, "edit_op": "nor_conv_1x1", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "With edge 5 removed, changing edge 4 to a 1x1 conv gained on all datasets, while most other parents were near 0 or negative."}], "tok": 31264, "bad": 0, "probes": [[["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["none", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none"], [0, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "skip_connect"], [0, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_connect", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [5, "nor_conv_3x3"]], [["skip_connect", "nor_conv_3x3", "skip_connect", "skip_connect", "skip_connect", "skip_connect"], [5, "nor_conv_3x3"]], [["skip_connect", "skip_connect", "nor_conv_3x3", "skip_connect", "skip_connect", "skip_con