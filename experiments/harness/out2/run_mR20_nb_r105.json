{"h": {"measure": "R", "k": 20}, "sp": "nb", "rep": 105, "hyps": [{"edit_edge": 5, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "none", "direction": "higher", "why": "Replacing a missing final edge with a 3x3 conv adds a whole new learnable path, which gains more than upgrading an existing op."}, {"edit_edge": 0, "edit_op": "nor_conv_1x1", "cond_edge": 0, "cond_op": "none", "direction": "higher", "why": "Reconnecting the input edge with a conv gives a larger gain than swapping one op for another."}, {"edit_edge": 3, "edit_op": "nor_conv_3x3", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a conv on the direct input-to-output edge where none existed gains more than replacing an existing op."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting a 3x3 conv removes a major feature path and costs more than deleting a weak op."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Cutting the conv on the input edge starves downstream edges and hurts accuracy heavily."}, {"edit_edge": 5, "edit_op": "skip_connect", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Downgrading a 3x3 conv to skip loses far more capacity than replacing a weaker op."}, {"edit_edge": 5, "edit_op": "avg_pool_3x3", "cond_edge": 5, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing a conv with pooling on the output edge strongly reduces accuracy."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Activating a dead edge with a conv gives a larger gain than replacing an existing op."}, {"edit_edge": 2, "edit_op": "nor_conv_1x1", "cond_edge": 2, "cond_op": "none", "direction": "higher", "why": "Adding a conv to a missing intermediate edge creates a new deeper path and gains more than a swap."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_ed