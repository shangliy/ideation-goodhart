{"h": {"measure": "R", "k": 20}, "sp": "nb", "rep": 101, "hyps": [{"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Replacing a missing edge with a 3x3 conv adds a learnable path, as in experiment 8 (+3.1/+6.2/+8.0), while replacing an existing op gains less."}, {"edit_edge": 2, "edit_op": "nor_conv_1x1", "cond_edge": 2, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a parameter-free pool for a conv gives a large gain, as in experiment 14 (+3.9/+8.7/+6.9)."}, {"edit_edge": 0, "edit_op": "avg_pool_3x3", "cond_edge": 0, "cond_op": "nor_conv_1x1", "direction": "lower", "why": "Replacing the first-layer conv with a pool cuts accuracy sharply on all datasets, as in experiments 9 and 13."}, {"edit_edge": 0, "edit_op": "avg_pool_3x3", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Pooling in place of a 3x3 conv on the input edge loses a lot of capacity, as in experiment 12 (-4.6/-7.4/-9.7)."}, {"edit_edge": 4, "edit_op": "none", "cond_edge": 4, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "Removing an existing pool edge hurts on all three datasets, as in experiment 7, and removing it is worse than removing a skip."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting the conv on the output edge costs accuracy on all three datasets, as in experiment 16, which is worse than editing an edge that is already weak."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing the direct-to-output 3x3 conv with a skip loses a lot of capacity, as in experiment 3 (-7.4/-6.6/-9.9)."}, {"edit_edge": 0, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Downgrading the input-edge 3x3 conv to a skip hurts on all three datasets, as in experiment 1."}, {"edit_edge": 4, "edit_op": "nor_conv_1x1", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "Adding a conv where the edge was missing yields a gain, as in experiment 15, unlike replacing an existing conv."}, {"edit_edge": 2, "edit_op": "none", "cond_edge": 2, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Deleting a 3x3 conv on the intermediate edge removes a useful path, whereas removing an already weak op costs little."}], "tok": 8154, "bad": 0, "probes": [[["nor_conv_3x3", "skip_connect", "nor_conv_1x1", "nor_conv_3x3", "avg_pool_3x3", "none"], [0, "skip_connect"]], [["nor_conv_1x1", "skip_connect", "none", "skip_connect", "nor_conv_3x3", "nor_conv_1x1"], [3, "nor_conv_1x1"]], [["avg_pool_3x3", "none", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_1x1", "none", "none", "skip_connect", "nor_conv_3x3"], [4, "avg_pool_3x3"]], [["nor_conv_3x3", "skip_connect", "avg_pool_3x3", "none", "nor_conv_1x1", "nor_conv_1x1"], [5, "nor_conv_3x3"]], [["avg_pool_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "skip_connect", "avg_pool_3x3"], [4, "none"]], [["nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3", "none"], [4, "none"]], [["none", "none", "skip_connect", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [1, "nor_conv_3x3"]], [["nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "avg_pool_3x3", "nor_conv_3x3"], [0, "avg_pool_3x3"]], [["none", "nor_conv_3x3", "none", "nor_conv_3x3", "none", "avg_pool_3x3"], [3, "nor_conv_1x1"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_1x1", "none"], [5, "avg_pool_3x3"]], [["nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "skip_connect", "skip_connect", "nor_conv_1x1"], [0, "avg_pool_3x3"]], [["nor_conv_1x1", "none", "nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect"], [0, "avg_pool_3x3"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3", "none", "skip_connect"], [2, "nor_conv_1x1"]], [["skip_