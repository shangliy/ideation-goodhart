{"h": {"measure": "A", "k": 100, "noise": "L"}, "sp": "nb", "rep": 136, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a skip where edge 3 is empty creates the cell's only input-to-output residual path, giving the largest gains (exps 1,5,9,17)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Replacing a 3x3 conv on edge 3 with identity removes learned capacity, giving small or negative changes (exps 6,10,14,18)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "In pooling-dominated cells the edge-3 skip yields little or hurts (exps 13-16)."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "higher", "why": "Conv-heavy cells benefit consistently from a residual path on edge 3 (exps 1-4, 9-12)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "When edge 3 is empty, a node1-to-output skip acts as a residual connection and helps strongly (exps 65-68, 73-76)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "skip_connect", "direction": "lower", "why": "With an existing input-output skip, a second skip on edge 4 is redundant and often harmful (exps 61-64, 69-72)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 0, "cond_op": "avg_pool_3x3", "direction": "lower", "why": "In pooling cells edge 4 holds the only conv, so replacing it with identity costs a lot (exps 79-80)."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 4, "cond_op": "avg_pool_3x3", "direction": "higher", "why": "Swapping a parameter-free pool for identity loses no learned capacity, so it is milder or beneficial (exps 63,67,71,75)."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "none", "direction": "higher", "why": "Adding a new conv path on edge 1 adds capacity without removing anything (exps 81,85,89,93,97,99,100)."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 1, "cond_op": "skip_connect", "direction": "lower", "why": "Replacing an identity path on edge 1 with a conv offsets the gain from the conv (exps 82,86,90,94)."}], "tok": 17756, "bad": 0, "probes": [[["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "none", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "avg_pool_3x3", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "none", "none", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "nor_conv_3x3", "none", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "avg_pool_3x3", "none", "none"], [3, "skip_connect"]], [["nor_conv_3x3", "none", "none", "nor_conv_1x1", "none", "none"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "none", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3"], [3, "skip_connect"]], [["avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3x3", "avg_pool_3