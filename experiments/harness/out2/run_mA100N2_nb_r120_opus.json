{"h": {"measure": "A", "k": 100, "noise": "N2"}, "sp": "nb", "rep": 120, "hyps": [{"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Adding a residual where none exists helps far more than replacing an existing conv/pool on the 0->3 edge."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "With edge 4 missing, deleting edge 3 removes one of very few paths to the output and can cripple the cell."}, {"edit_edge": 5, "edit_op": "none", "cond_edge": 4, "cond_op": "none", "direction": "lower", "why": "When edge 4 is absent, edge 5 carries the cell's conv computation to the output, so removing it is much more damaging."}, {"edit_edge": 0, "edit_op": "none", "cond_edge": 1, "cond_op": "none", "direction": "lower", "why": "If edge 1 is none, removing edge 0 disconnects nodes 1 and 2 from the input, collapsing all conv paths."}, {"edit_edge": 4, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "Adding a new conv path from node 1 to the output helps more than swapping an existing op on that edge."}, {"edit_edge": 0, "edit_op": "nor_conv_3x3", "cond_edge": 5, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Conv-rich cells already have enough learnable capacity, so an extra conv on edge 0 adds little compared to pool/skip-dominated cells."}, {"edit_edge": 1, "edit_op": "nor_conv_3x3", "cond_edge": 4, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "When a conv already exists on the node1->output path, adding a conv on edge 1 is largely redundant."}, {"edit_edge": 4, "edit_op": "skip_connect", "cond_edge": 3, "cond_op": "none", "direction": "higher", "why": "Without the input->output skip, a skip on edge 4 supplies the missing residual-like shortcut that eases optimization."}, {"edit_edge": 3, "edit_op": "skip_connect", "cond_edge": 4, "cond_op": "none", "direction": "higher", "why": "With edge 4 absent the cell has few output paths, so a direct input->output skip restores gradient flow and capacity."}, {"edit_edge": 3, "edit_op": "none", "cond_edge": 0, "cond_op": "nor_conv_3x3", "direction": "lower", "why": "Removing the residual hurts conv-based cells, whereas in degenerate all-pool/all-skip cells removing it can actually help."}], "tok": 17970, "bad": 0, "probes": [[["nor_conv_3x3", "none", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "skip_connect", "none", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "none", "skip_connect", "skip_connect", "nor_conv_3x3", "none"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "avg_pool_3x3", "avg_pool_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "skip_connect"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "skip_connect", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "avg_pool_3x3"], [5, "nor_conv_3x3"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "none", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "avg_pool_3x3", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_3x3", "nor_conv_3x3", "nor_conv_3x3", "nor_conv_1x1", "nor_conv_3x3", "nor_conv_3x3"], [3, "skip_connect"]], [["nor_conv_1x1", "nor_conv_1x1", "nor_conv_1x1", "n